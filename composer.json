{
    "name": "tomsgu/tolgee-translation-provider",
    "type": "symfony-translation-bridge",
    "description": "Symfony Tolgee Translation Provider Bridge",
    "keywords": ["tolgee", "translation", "provider"],
    "homepage": "https://symfony.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Tomas Jakl",
            "homepage": "https://github.com/tomsgu"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/config": "^6.0",
        "symfony/http-client": "^6.0",
        "symfony/translation": "^6.0",
        "symfony/framework-bundle": "^6.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.6",
        "vimeo/psalm": "4.23",
        "symplify/easy-coding-standard": "^10.0"
    },
    "autoload": {
        "psr-4": { "Tomsgu\\TolgeeTranslationProvider\\": "src/" },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tomsgu\\TolgeeTranslationProvider\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev"
}
